{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "allowJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "./apps/bacayuk-admin/node_modules/@types/react"
      ],
      "react/*": [
        "./apps/bacayuk-admin/node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "apps/bacayuk-admin/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile",
    "apps/server"
  ]
}